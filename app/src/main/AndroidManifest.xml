<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      The complete permission set. INTERNET is for Drive sync only; the app is fully
      functional with it revoked. Notifications, contacts, storage, location and camera are
      not requested at all - see docs/11-privacy-model.md section 6.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />

    <!--
      Fully-qualified class names, deliberately. The namespace is `com.passwird` but the
      classes live in `com.passwird.vaultapp`, so the shorthand `.PasswirdApplication`
      resolved to `com.passwird.PasswirdApplication` - a class that does not exist. The app
      would have died with ClassNotFoundException before its first frame. Lint's MissingClass
      check caught it on the first run; nothing else would have, short of launching the app.
    -->
    <application
        android:name="com.passwird.vaultapp.PasswirdApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.Passwird"
        android:supportsRtl="true"

        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:hasFragileUserData="false"

        tools:targetApi="34">

        <!--
          allowBackup=false is not optional here. Android's automatic backup would otherwise
          copy app-private files - including the encrypted vault, the sync watermark and the
          Keystore-wrapped account record - to Google's servers under a different protection
          model than the one this product documents. dataExtractionRules additionally blocks
          adb backup and device-to-device transfer for the same paths, so the guarantees in
          docs/02-threat-model.md hold on the extraction paths too.
        -->

        <activity
            android:name="com.passwird.vaultapp.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:excludeFromRecents="false">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          No other exported component exists. No custom URL scheme accepts vault data, no
          content provider is published, and no service is exposed - so there is no IPC
          surface for another app to reach.
        -->

        <!--
          androidx.startup's InitializationProvider is deliberately NOT removed.

          It was previously stripped with tools:node="remove", which is common advice for
          trimming startup providers - and here it would have silently disabled a security
          control. lifecycle-process registers ProcessLifecycleInitializer through that
          provider, and AppLockController's lock-on-background depends on
          ProcessLifecycleOwner receiving events. With the provider removed, the observer is
          registered against a lifecycle that never dispatches: the app looks fine, and the
          vault simply never locks when backgrounded.

          The provider is not exported and adds one class to startup. That is the whole cost.
        -->

    </application>
</manifest>
